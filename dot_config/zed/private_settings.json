// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "colorize_brackets": false,
  "buffer_font_family": ".ZedMono",
  "ui_font_family": ".ZedSans",
  "context_servers": {
    "postgres-context-server": {
      "enabled": true,
      "settings": {
        "database_url": "postgresql://telescope:telescope@127.0.0.1:5432/telescope"
      }
    }
  },
  "diagnostics_max_severity": "off",
  "gutter": {
    "min_line_number_digits": 3
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    }
  },
  "title_bar": {
    "show_branch_name": false
  },
  "buffer_line_height": { "custom": 2.5 },
  "autoscroll_on_clicks": true,
  "debugger": {
    "dock": "right"
  },
  "format_on_save": "off",
  "outline_panel": {
    "dock": "right",
    "default_width": 400,
    "indent_size": 25,
    "indent_guides": {
      "show": "never"
    },
    "scrollbar": {
      "show": "never"
    }
  },
  "terminal": {
    "font_size": 16.5,
    "detect_venv": "off",
    "copy_on_select": true,
    "font_family": "Ubuntu"
  },
  "icon_theme": "Material Icon Theme",
  "ssh_connections": [
    {
      "host": "photobooth",
      "projects": [
        {
          "paths": ["/var/www/html"]
        }
      ]
    }
  ],
  "edit_predictions": {
    "disabled_globs": [".env", "notes.md"]
  },
  "agent": {
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    },
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    }
  },
  "cursor_shape": "underline",
  "show_signature_help_after_edits": true,
  "autosave": "on_focus_change",
  "ui_font_size": 18,
  "buffer_font_size": 15.5,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "One Light"
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 0.8
  },
  "indent_guides": {
    "enabled": false
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "notification_panel": {
    "button": false
  },
  "git_panel": {
    "sort_by_path": true
  },
  "project_panel": {
    "dock": "left",
    "hide_gitignore": false,
    "indent_guides": {
      "show": "never"
    },
    "auto_fold_dirs": false,
    "git_status": false,
    "indent_size": 15.0,
    "scrollbar": {
      "show": "never"
    },
    "show_diagnostics": "off",
    "hide_root": true
  },
  "auto_signature_help": true,
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "diagnostics": {
    "include_warnings": false,
    "lsp_pull_diagnostics": {
      "enabled": true
    },
    "inline": {
      "enabled": false,
      "padding": 4,
      "min_column": 80,
      "max_severity": "error"
    }
  },
  "experimental.theme_overrides": {
    "editor.active_line_number": "#fabd2f",
    "syntax": {
      "function": {
        "font_style": "italic"
      },
      "comment": {
        "font_style": "italic"
      },
      "class": {
        "font_weight": 700,
        "color": "#fabd2f"
      }
    }
  }
}
