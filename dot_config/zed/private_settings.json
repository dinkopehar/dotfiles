{
  "disable_ai": true,
  "diff_view_style": "unified",
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "buffer_font_size": 16,
  "ui_font_size": 17,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "GitHub Dark Default",
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "html": true,
    "toml": true,
    "sql": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "format_on_save": "off",
  "terminal": {
    "copy_on_select": true,
  },
  "autosave": "on_focus_change",
  "indent_guides": {
    "enabled": false
  },
  "collaboration_panel": {
    "button": false,
  },
  "project_panel": {
    "dock": "left",
    "indent_guides": {
      "show": "never"
    },
    "auto_fold_dirs": false,
    "hide_root": true
  }
}
