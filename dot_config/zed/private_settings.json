{
  "agent": {
    "dock": "left",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "diff_view_style": "unified",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 17,
  "buffer_font_size": 15.5,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "html": true,
    "toml": true,
    "sql": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "format_on_save": "off",
  "terminal": {
    "copy_on_select": true,
  },
  "autosave": "on_focus_change",
  "indent_guides": {
    "enabled": false
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "project_panel": {
    "dock": "right",
    "indent_guides": {
      "show": "never"
    },
    "auto_fold_dirs": false,
    "hide_root": true
  }
}
